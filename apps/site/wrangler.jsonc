{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // smurg.ai: the product page and the user docs. Static files in dist/ (built from public/ and the repository's
  // docs, see "build" below) plus a small Worker (src/index.ts) for the redirects (/install.sh, /github, /source).
  // The workspace app (relay + SPA) is a different Worker, on app.smurg.ai.
  "name": "smurg-site",
  "main": "src/index.ts",
  // Same date as apps/relay: <= the workerd bundled with the repo's wrangler 4.142.0.
  "compatibility_date": "2026-09-26",

  // Served only on the custom domain below: no *.workers.dev hostname, no per-version preview URLs.
  // Custom domain: on deploy, Cloudflare creates the DNS record and certificate for smurg.ai (the smurg.ai zone must
  // be on the same Cloudflare account).
  // The apex ONLY. Never add www.smurg.ai here: www is the owner's own proxied DNS record plus the zone Redirect Rule
  // "www -> https://smurg.ai/<path>, 301, query kept" (created 2026-10-01; README.md, "Deploying"). The rule runs
  // before any Worker, so this Worker never sees www traffic. A www custom domain would conflict with that record, and
  // wrangler as run after `source scripts/env.sh` (CI=true) replaces an existing record without asking (header of
  // apps/relay/scripts/deploy.ts, step 5). This is the route list deployed on 2026-10-01; test/config.test.ts asserts
  // exactly it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "smurg.ai", "custom_domain": true }],

  // The custom build: wrangler runs it before `wrangler deploy` (and --dry-run), `wrangler dev` and the tests' local
  // workerd, so dist/ is always built from this checkout (public/, the guides and changelogs in docs/ and docs/zh-TW/,
  // CHANGELOG.md, LICENSE and the third-party notices; scripts/build.ts lists its environment). wrangler runs the command from its
  // own working directory, hence the absolute path through SMURG_ROOT (set by `source scripts/env.sh`); the build
  // refuses to run for a wrangler started outside this checkout.
  "build": {
    "command": "node \"${SMURG_ROOT:?run source scripts/env.sh first}/apps/site/scripts/build.ts\"",
    "watch_dir": ["./src", "./scripts", "./public", "../../docs"]
  },

  "assets": {
    // Generated by the build above (gitignored): never edit it, edit public/ or the docs.
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get the nearest 404.html (zh-TW/404.html under /zh-TW/, 404.html everywhere else) with status 404.
    "not_found_handling": "404-page",
    // /zh-TW -> /zh-TW/, /docs -> /docs/, /zh-TW/docs -> /zh-TW/docs/, /index.html -> /
    "html_handling": "auto-trailing-slash",
    // QUOTA: Workers Free counts 100,000 Worker requests a day for the WHOLE Cloudflare account, and the shared relay
    // lives on the same account (docs/RELEASING.md). Requests for static files that do not run the Worker are free
    // and unlimited. So the Worker runs first only for its redirects (src/routes.ts WORKER_PATHS; a test keeps the two
    // equal); pages, docs, the stylesheet, the script, the icon and the 404 page cost no Worker request.
    // www.smurg.ai -> smurg.ai, for every path, is the zone Redirect Rule, which runs before Workers and costs no
    // Worker request (README.md, "Deploying").
    "run_worker_first": ["/install.sh", "/github", "/source"]
  }
}
