{
  "name": "@smurg/site",
  "version": "0.5.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "smurg.ai: the product page (hand-written static HTML/CSS) and the user docs rendered from the repository at build time, served by a Cloudflare Worker with static assets and one redirect.",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/assert-env.mjs && node scripts/build.ts",
    "dev": "node ../../scripts/assert-env.mjs && SMURG_SITE_ALLOW_PLACEHOLDER=1 wrangler dev --ip 127.0.0.1 --port ${SMURG_SITE_DEV_PORT:-8790}",
    "dry-run": "node ../../scripts/assert-env.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "social-card": "node ../../scripts/assert-env.mjs && node scripts/social-card.ts",
    "typecheck": "node ../../scripts/assert-env.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "marked": "14.0.0",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
