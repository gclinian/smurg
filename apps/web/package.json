{
  "name": "@smurg/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "smurg web app: React + Vite SPA (Monaco, Yjs, xterm.js). Served by the relay Worker in production.",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-chunks.ts",
    "check:chunks": "node scripts/check-chunks.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@smurg/protocol": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lib0": "0.2.118",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
