{
  "disableAllHooks": false,
  "env": {
    "CLAUDE_CODE_SAFE_MODE": "0",
    "CLAUDE_CODE_SIMPLE": "0"
  },
  "disableDeepLinkRegistration": "disable",
  "crossSessionInbound": "refuse",
  "permissions": {
    "allow": [
      "mcp__smurg"
    ],
    "ask": [],
    "deny": [
      "ListAgents",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.envrc)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.envrc)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.git/**)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.git/**)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.claude/settings.local.json)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.claude/settings.local.json)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/CLAUDE.local.md)",
      "Read(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/CLAUDE.local.md)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.claude/**)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.claude/**)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.git/**)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.git/**)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/.mcp.json)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/**/.mcp.json)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/specs/wishlist/SPEC.md)",
      "Edit(//__SMURG_FIXTURE__/project/.smurg/worktrees/wt_c112e9bccd1a636559175ea0/specs/wishlist/PLAN.md)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".gitignore|.mcp.json|README.md|conflict.txt|feature.txt",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/node",
            "args": [
              "/__SMURG_FIXTURE__/smurg-src/packages/cli/src/main.ts",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
