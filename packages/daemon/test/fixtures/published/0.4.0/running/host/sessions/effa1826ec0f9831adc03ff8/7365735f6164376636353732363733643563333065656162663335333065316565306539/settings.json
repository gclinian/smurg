{
  "disableAllHooks": false,
  "env": {
    "CLAUDE_CODE_SAFE_MODE": "0",
    "CLAUDE_CODE_SIMPLE": "0"
  },
  "disableDeepLinkRegistration": "disable",
  "permissions": {
    "allow": [
      "mcp__smurg"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook",
              "bash-activity"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".gitignore|README.md|conflict.txt",
        "hooks": [
          {
            "type": "command",
            "command": "/__SMURG_FIXTURE__/bin/smurg",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
