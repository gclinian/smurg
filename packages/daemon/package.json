{
  "name": "@smurg/daemon",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Host-side daemon: files, documents, locks, PTY sessions, hooks, audit log.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./fakes": "./src/core/fakes/index.ts",
